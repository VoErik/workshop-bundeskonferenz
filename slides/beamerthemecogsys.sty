  \raggedright
  {\usebeamerfont{caption name}\usebeamercolor[fg]{caption name}%
   \MakeUppercase{\insertcaptionname}~\insertcaptionnumber}\hskip2mm
  {\usebeamerfont{caption}\usebeamercolor[fg]{caption}\insertcaption}\par}
