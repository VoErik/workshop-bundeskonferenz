%% ---------------------------------------------------------------------------
%% Background: logo, edge marker, title and section page
%% ---------------------------------------------------------------------------
\setbeamertemplate{background}{%
  \csname cogsys@prepare@\cogsys@pagekind\endcsname
  \cogsys@canvas{\paperwidth}{\paperheight}{%
    % university logo: 13 x 13 mm, 5.5 mm from top, 6.5 mm from right
    \IfFileExists{\cogsys@unilogo}{%
      \cogsys@put{\paperwidth-6.5mm}{5.5mm}{tr}%
        {\includegraphics[width=13mm,height=13mm]{\cogsys@unilogo}}}{}%
    % edge marker
