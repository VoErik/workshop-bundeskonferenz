%% ---------------------------------------------------------------------------
%% Fonts
%% ---------------------------------------------------------------------------
% Atkinson Hyperlegible Next + Mono, as shipped by the CTAN package
% `atkinson' (TeX Live 2025+, MiKTeX). pdfLaTeX gets the Type 1 version,
% LuaLaTeX/XeLaTeX the OpenType version. If the package (or the 2025 version
% containing Next and Mono) is missing, the theme falls back to the default
% beamer fonts with a warning.
\newif\ifcogsys@atkinson
\def\cogsys@str@none{none}
\def\cogsys@ttscale{1000} % mono size relative to the requested size, in 1/1000
\def\cogsys@medium{\mdseries}
\ifx\cogsys@font\cogsys@str@none\else
  % The 2025 `atkinson' package ships Next + Mono as Type 1 (with .fd files)
  % and OpenType; the .fd file is visible to \IfFileExists on every engine.
  \IfFileExists{T1atkinsnmono-TLF.fd}{\cogsys@atkinsontrue}{}%
  \ifcogsys@atkinson\else
    \PackageWarningNoLine{beamerthemecogsys}{%
      Atkinson Hyperlegible Next/Mono not found.\MessageBreak
      Install the `atkinson' package (2025 or newer),\MessageBreak
      e.g. `tlmgr install atkinson'. Falling back to\MessageBreak
      the default fonts}%
  \fi
\fi
\ifcogsys@atkinson
  \ifcogsys@pdftex
    \RequirePackage[T1]{fontenc}
    \ifcogsys@monoscale
      % Mono is wider than Next; scale it so inline code sits in running text.
      \def\atkinsnmono@scale{0.9}\def\cogsys@ttscale{900}
    \fi
    \RequirePackage{atkinson}
    \def\cogsys@medium{\fontseries{medium}\selectfont}
  \else
    \RequirePackage[nomono]{atkinson}
    \ifcogsys@monoscale\def\cogsys@ttscale{900}\fi
    \setmonofont[Extension = .otf,
                 Scale = \fpeval{\cogsys@ttscale/1000},
                 UprightFont = *-Regular, ItalicFont = *-RegularItalic,
                 BoldFont = *-Bold, BoldItalicFont = *-BoldItalic]
                {AtkinsonHyperlegibleMono}
    \newfontface\cogsys@mediumface[Extension = .otf]{AtkinsonHyperlegibleNext-Medium}
    \def\cogsys@medium{\cogsys@mediumface}
  \fi
\fi

\newdimen\cogsys@dima
\newdimen\cogsys@dimb
\newdimen\cogsys@dimc
\newbox\cogsys@box

% \cogsys@fs{<size in pt>}{<leading factor>}: set size, leading = factor * size
\def\cogsys@fs#1#2{%
  \cogsys@dima=#1pt\relax
  \cogsys@dimb=#2\cogsys@dima
  \fontsize{\strip@pt\cogsys@dima}{\the\cogsys@dimb}\selectfont}
% \cogsys@mono{<size>}{<leading factor>}: mono at exactly <size> on the page
\def\cogsys@mono#1#2{%
  \ttfamily
  \cogsys@dima=#1pt\relax
  \cogsys@dimb=#2\cogsys@dima
  \cogsys@dima=\dimexpr\cogsys@dima*1000/\cogsys@ttscale\relax
  \fontsize{\strip@pt\cogsys@dima}{\the\cogsys@dimb}\selectfont}

% Negative tracking for display type, in 1/1000 em (pdfTeX and fontspec only)
\def\cogsys@track#1{%
  \ifcogsys@tracking
    \ifcogsys@pdftex
      \expandafter\ifx\csname cogsys@ls@\fontname\font @#1\endcsname\relax
        \letterspacefont\cogsys@lsfont\font #1\relax
        \expandafter\global\expandafter\let
          \csname cogsys@ls@\fontname\font @#1\endcsname\cogsys@lsfont
      \fi
      \csname cogsys@ls@\fontname\font @#1\endcsname
    \else\ifcogsys@atkinson
      \addfontfeatures{LetterSpace=\fpeval{#1/10}}%
    \fi\fi
  \fi}

