%% ---------------------------------------------------------------------------
%% Relaxed title gap
%% ---------------------------------------------------------------------------
% A slide whose body (with its footnotes and references) would run past the
% text area moves the body up, by the overflow, but at most so far that the
% first element on the slide (the ascenders of a text line, the top of an
% image, the tab of a block) stays \cogsys@titlerelaxgap below the title
% underline. Whatever overflow is left is handled as before (list spacing
% shrinks, then the box is overfull). Options titlerelax, titlerelaxgap;
% frame option norelax.
% beamer typesets the body before the title, so once the title box is built
% the complete slide can be measured; the shift is added to the title box.
% All slides of a frame get the same shift: the largest one over its
% slides, from the .aux file of the previous run.
\newdimen\cogsys@relaxapplied % the shift of the current slide
\newdimen\cogsys@relaxlimit   % the largest shift the current slide allows
\newdimen\cogsys@relaxtop     % top edge of the body
\newdimen\cogsys@relaxover    % overflow
\newdimen\cogsys@relaxoffset  % top of the body -> its first box
\newdimen\cogsys@relaxbase    % top of the body -> baseline of its first box
\newdimen\cogsys@colinktop    % see \cogsys@colmeasure
\newif\ifcogsys@colsfirst     % the slide opens with columns
\newdimen\cogsys@topoverhang  % a block tab above the first box
\newif\ifcogsys@tabattop      % the block being set opens the slide
% right after beamer has built the title box (the frametitle template sets
% \cogsys@titlerule; other templates leave it at 0)
\patchcmd\endbeamer@frameslide{\ifbeamer@shrink\beamer@shrinkframebox\fi}%
  {\cogsys@relaxtitle\ifbeamer@shrink\beamer@shrinkframebox\fi}{}%
  {\PackageWarningNoLine{beamerthemecogsys}{Could not patch beamer's frame;
    the gap below frame titles is never relaxed}}
\def\cogsys@relaxtitle{%
  \ifcogsys@titlerelax\ifcogsys@norelax\else
  \ifbeamer@autobreak\else\ifbeamer@shrink\else\ifbeamer@plainframe\else
  \ifbeamer@slidehaszoom\else\ifx\beamer@zoomer\@empty
  \ifvoid\beamer@frametitlebox\else\ifdim\cogsys@titlerule>\z@
    \cogsys@relaxmeasure
    \ifdim\cogsys@relaxapplied>\z@
      \setbox\beamer@frametitlebox\vbox{%
        \unvbox\beamer@frametitlebox\vskip-\cogsys@relaxapplied}%
      \advance\beamer@frametextheight\cogsys@relaxapplied
    \fi
  \fi\fi\fi\fi\fi\fi\fi\fi\fi}
\def\cogsys@relaxmeasure{%
  % the references belong to the slide, the title's ones are known by now
  \cogsys@flushbibs
  % \beamer@framebox holds the body, which starts below the title box and
  % beamer's top skip (natural width)
  \cogsys@relaxtop=\dimexpr\ht\beamer@frametitlebox+\dp\beamer@frametitlebox
    +\beamer@frametopskip\relax
  \cogsys@framenatural\cogsys@relaxover
  \cogsys@relaxover=\dimexpr\cogsys@relaxtop+\cogsys@relaxover-\textheight\relax
  \cogsys@firstbox\beamer@framebox
  % columns opening the slide: their content may rise above the row of
  % columns ([T] columns start 1ex up); \cogsys@colinktop is measured from
  % the baseline of the row
  \ifcogsys@colsfirst\ifdim\cogsys@colinktop<\maxdimen
    \ifdim\cogsys@relaxbase>-\maxdimen
      \cogsys@relaxoffset=\dimexpr\cogsys@relaxbase+\cogsys@colinktop\relax
    \fi
  \fi\fi
  \ifdim\cogsys@relaxoffset>-\maxdimen
    \global\cogsys@relaxlimit=\dimexpr\cogsys@relaxtop+\cogsys@relaxoffset
      -\cogsys@topoverhang-\cogsys@titlerule-\cogsys@titlerelaxgap\relax
    \ifdim\cogsys@relaxlimit<\z@ \global\cogsys@relaxlimit=\z@ \fi
  \fi
  % the shift this slide needs
  \ifdim\cogsys@relaxover<\z@ \cogsys@relaxover=\z@ \fi
  \ifdim\cogsys@relaxover>\cogsys@relaxlimit
    \cogsys@relaxover=\cogsys@relaxlimit
  \fi
  % the shift of the frame: the largest over its slides (previous run)
  \edef\cogsys@rid{\beamer@framestartpage}%
  \global\cogsys@relaxapplied=\cogsys@relaxover
  \ifcsname cogsys@relaxaux@\cogsys@rid\endcsname
    \ifdim\csname cogsys@relaxaux@\cogsys@rid\endcsname>\cogsys@relaxapplied
      \global\cogsys@relaxapplied=\csname cogsys@relaxaux@\cogsys@rid\endcsname\relax
    \fi
  \fi
  \ifdim\cogsys@relaxapplied>\cogsys@relaxlimit
    \global\cogsys@relaxapplied=\cogsys@relaxlimit
  \fi
  % the largest over the slides of this run, for the next run
  \ifcsname cogsys@relaxmax@\cogsys@rid\endcsname
    \ifnum\c@page>\beamer@framestartpage\relax
      \ifdim\csname cogsys@relaxmax@\cogsys@rid\endcsname>\cogsys@relaxover
        \cogsys@relaxover=\csname cogsys@relaxmax@\cogsys@rid\endcsname\relax
      \fi
    \fi
  \else
    \xdef\cogsys@relaxids{\cogsys@relaxids,\cogsys@rid}%
  \fi
  \expandafter\xdef\csname cogsys@relaxmax@\cogsys@rid\endcsname{%
    \the\cogsys@relaxover}%
  \ifdim\cogsys@relaxover>\z@
    \immediate\write\@auxout{\string\cogsys@relaxrecord
      {\cogsys@rid}{\the\cogsys@relaxover}}%
  \fi}
\def\cogsys@relaxrecord#1#2{\global\@namedef{cogsys@relaxaux@#1}{#2}}
\def\cogsys@relaxids{}
% \cogsys@firstbox<vbox>: \cogsys@relaxoffset := distance from the top of
% <vbox> to the top of its first box, \cogsys@relaxbase := to its baseline
% (-\maxdimen: no box). Everything above that box is split off (at height 0,
% the last break that fits wins); the rest starts with \splittopskip minus
% the height of the box (if positive).
\newbox\cogsys@splitsrc
\def\cogsys@firstbox#1{%
  \begingroup
    \splitmaxdepth\maxdimen \vbadness\@M \vfuzz\maxdimen
    \setbox\cogsys@splitsrc\copy#1%
    \dimen@=\dimexpr\ht\cogsys@splitsrc+\dp\cogsys@splitsrc\relax
    \splittopskip\z@
    \setbox\@tempboxa\copy\cogsys@splitsrc
    \setbox\tw@\vsplit\@tempboxa to\z@
    \ifvoid\@tempboxa
      \global\cogsys@relaxoffset=-\maxdimen \global\cogsys@relaxbase=-\maxdimen
    \else
      \global\cogsys@relaxoffset=\dimexpr\dimen@-\ht\@tempboxa-\dp\@tempboxa\relax
      \splittopskip=1000pt
      \setbox\@tempboxa\copy\cogsys@splitsrc
      \setbox\tw@\vsplit\@tempboxa to\z@
      \global\cogsys@relaxbase=\dimexpr\dimen@-\ht\@tempboxa-\dp\@tempboxa
        +1000pt\relax
    \fi
  \endgroup}
% \cogsys@framenatural<dimen>: natural height of \beamer@framebox with the
% footnotes below it, as beamer places them; without footnotes, the space
% below a closing block does not count
\def\cogsys@framenatural#1{%
  \setbox\@tempboxa\vbox{%
    \unvcopy\beamer@framebox
    \ifvoid\beamer@footins\unskip\fi
    \vskip\beamer@framebottomskip
    \ifvoid\beamer@footins\else
      \footnoterule\unvcopy\beamer@footins
    \fi}%
  #1=\dimexpr\ht\@tempboxa+\dp\@tempboxa\relax}
% compare with the previous run
\AtEndDocument{%
  \@for\cogsys@tmp:=\cogsys@relaxids\do{%
    \ifx\cogsys@tmp\@empty\else
      \cogsys@dimb=\csname cogsys@relaxmax@\cogsys@tmp\endcsname\relax
      \ifcsname cogsys@relaxaux@\cogsys@tmp\endcsname
        \advance\cogsys@dimb-\csname cogsys@relaxaux@\cogsys@tmp\endcsname\relax
      \fi
      \ifdim\cogsys@dimb<\z@ \cogsys@dimb=-\cogsys@dimb \fi
      \ifdim\cogsys@dimb>0.01pt \global\cogsys@relaxreruntrue \fi
    \fi}%
  \ifcogsys@relaxrerun
    \PackageWarningNoLine{beamerthemecogsys}{The space below some frame
      titles has changed.\MessageBreak Rerun to get it right}%
  \fi}
\newif\ifcogsys@relaxrerun

%% ---------------------------------------------------------------------------
%% Lists
%% ---------------------------------------------------------------------------
% Nested lists step down one size from the text around them (beamer's
% defaults are the fixed \small and \footnotesize, which do not shrink on a
% \small frame and are larger than the block body).
% \cogsys@smaller: switch to the largest size command below the current size
\def\cogsys@smaller{%
  \edef\cogsys@cursize{\f@size}\let\cogsys@target\relax
  \cogsys@findsmaller\Huge\huge\LARGE\Large\large\normalsize
    \small\footnotesize\scriptsize\tiny\@nil
  \cogsys@target}
\def\cogsys@findsmaller#1{%
  \ifx#1\@nil\else
    \ifx\cogsys@target\relax
      \begingroup#1\expandafter\endgroup
      \ifdim\f@size pt<\cogsys@cursize pt\let\cogsys@target#1\fi
    \fi
    \expandafter\cogsys@findsmaller
  \fi}
\setbeamerfont{itemize/enumerate subbody}{size=\cogsys@smaller}
\setbeamerfont{itemize/enumerate subsubbody}{size=\cogsys@smaller}

% \cogsys@listsize: text size of the innermost list, taken when it begins
% (by the time a marker is set, \f@size is already the marker's size).
% Outside lists it is the current size.
\def\cogsys@listsize{\f@size}
\def\cogsys@setlistsize{\edef\cogsys@listsize{\f@size}}
\setbeamertemplate{itemize/enumerate body begin}{\cogsys@setlistsize}
\setbeamertemplate{itemize/enumerate subbody begin}{\cogsys@setlistsize}
\setbeamertemplate{itemize/enumerate subsubbody begin}{\cogsys@setlistsize}
\setbeamertemplate{description body begin}{\cogsys@setlistsize}

% itemize: mono dash; enumerate: two-digit mono numbers (01, 02, ...)
% raised 0.3 mm at the 10 pt body
\def\cogsys@marker#1{\cogsys@leftlabel{%
  \raise\cogsys@listsize\dimexpr0.03mm\relax\hbox{%
  \usebeamerfont{item}\usebeamercolor[fg]{item}#1}}}
\setbeamertemplate{itemize item}{\cogsys@marker{\textendash}}
\setbeamertemplate{itemize subitem}{\cogsys@marker{\textendash}}
\setbeamertemplate{itemize subsubitem}{\cogsys@marker{\textperiodcentered}}
\setbeamertemplate{enumerate item}{%
  \cogsys@marker{\cogsys@twodigits{\c@enumi}}}
\setbeamertemplate{enumerate subitem}{\cogsys@marker{\alph{enumii}}}
\setbeamertemplate{enumerate subsubitem}{\cogsys@marker{\roman{enumiii}}}
\setbeamertemplate{description item}{\insertdescriptionitem}

% beamer right-aligns labels in \labelwidth; we left-align them at the margin.
\def\cogsys@leftlabel#1{\hbox to\dimexpr\leftmargin-\labelsep\relax{#1\hss}}
\setlength\leftmargini{5.9mm}
\setlength\leftmarginii{4.5mm}
\setlength\leftmarginiii{4.5mm}
\setlength\labelsep{2.5mm}
\def\@listi{\leftmargin\leftmargini
  \topsep 0mm \@plus 1mm
  \parsep\z@ \itemsep 1.5mm \@plus 0.5mm \@minus 0.5mm}
\let\@listI\@listi
\def\@listii{\leftmargin\leftmarginii
  \topsep 0.75mm \@plus 0.5mm \parsep\z@ \itemsep 0.75mm}
\def\@listiii{\leftmargin\leftmarginiii
  \topsep 0.75mm \@plus 0.5mm \parsep\z@ \itemsep 0.75mm}

%% ---------------------------------------------------------------------------
%% Blocks
%% ---------------------------------------------------------------------------
% A ruled box with a tab sitting on the top rule, 2.5 mm from the left.
%   \cogsys@boxbegin{<filled|outlined>}{<tab text>}{<rule width>}
%   ... body ...
%   \cogsys@boxend
\newbox\cogsys@blockbox
\newdimen\cogsys@blockrule
\newdimen\cogsys@padtop     % rule top -> top of the first line box
\newdimen\cogsys@padbottom  % last baseline -> outer bottom edge
\newdimen\cogsys@padside    % right
\newdimen\cogsys@padleft
\newdimen\cogsys@blockwidth
\newdimen\cogsys@blockabove \cogsys@blockabove=6.81mm % last baseline -> rule
\newdimen\cogsys@blockbelow \cogsys@blockbelow=2.5mm
\def\cogsys@tabtextfont{\normalfont\usebeamerfont{block title}}
\def\cogsys@tababove{1.37mm}\def\cogsys@tabbelow{1.44mm}

% Depth of the last line that the paddings already account for: at most
% that of a text line. Anything deeper (a tabular hangs half below its
% baseline) keeps its extra depth.
\def\cogsys@linedepth{%
  \ifdim\prevdepth>\dp\strutbox \dp\strutbox
  \else\ifdim\prevdepth>\z@ \prevdepth
  \else\z@\fi\fi}

\def\cogsys@blockdefaults{%
  \cogsys@padtop=2.54mm \cogsys@padbottom=4.3mm
  \cogsys@padside=3mm \cogsys@padleft=3.25mm}

% Vertical placement: the top rule sits \cogsys@blockabove below the last
% baseline above; the tab overhangs without taking space.
% At the top of a [T] column (beamer adds \vskip-1ex there) a block either
% follows other content (same gap as outside the columns) or opens the
% frame (top rule level with the cap height of a neighbouring text column).
\newdimen\cogsys@blockcoltop   \cogsys@blockcoltop=3.5mm
\newdimen\cogsys@blockframetop \cogsys@blockframetop=0.6mm
\newif\ifcogsys@bodytop      % nothing typeset in the frame body yet
\newif\ifcogsys@colsatbodytop % current columns opened the frame body
\newif\ifcogsys@afterblock    % the previous element was a block
\AddToHook{para/begin}{\global\cogsys@bodytopfalse\global\cogsys@afterblockfalse}
\AddToHook{env/columns/begin}{%
  \ifcogsys@bodytop
    \cogsys@colsatbodytoptrue
    \global\cogsys@colsfirsttrue \global\cogsys@colinktop=\maxdimen
  \else\cogsys@colsatbodytopfalse\fi}
\def\cogsys@blockstart{%
  \par
  % a block opening the slide (or a column that opens it): its tab rises
  % above everything else, see \cogsys@tab
  \global\cogsys@tabattopfalse
  \ifcogsys@bodytop \global\cogsys@tabattoptrue \fi
  \ifdim\prevdepth>-999pt\else
    \ifdim\lastskip=-1ex \ifcogsys@colsatbodytop
      \global\cogsys@tabattoptrue
    \fi\fi
  \fi
  \ifcogsys@afterblock
    % stacked blocks: 5.5 mm between the boxes, plus room for the tab
    \vskip\dimexpr7.65mm-\cogsys@blockbelow\relax
  \else\ifdim\prevdepth>-999pt
    \vskip\dimexpr\cogsys@blockabove-\cogsys@linedepth\relax
  \else
    \ifdim\lastskip=-1ex
      \ifcogsys@colsatbodytop\vskip\cogsys@blockframetop
      \else\vskip\cogsys@blockcoltop\fi
    \fi
  \fi\fi
  \global\cogsys@bodytopfalse
  \nointerlineskip}

\def\cogsys@boxbegin#1#2#3{%
  \cogsys@blockstart
  \cogsys@blockdefaults
  \csname cogsys@pad@#1\endcsname % per-style paddings, if any
  \edef\cogsys@tabstyle{#1}%
  % beamer passes the block title as \insertblocktitle: look one level
  % inside, an empty or blank title means no tab
  \expandafter\cogsys@settabtext\expandafter{#2}%
  \ifx\cogsys@tabtext\@empty\advance\cogsys@padtop-0.75mm\fi
  \cogsys@blockrule=#3\relax
  \cogsys@blockwidth=\linewidth
  \setbox\cogsys@blockbox\vbox\bgroup\color@begingroup
    \hsize=\dimexpr\cogsys@blockwidth-\cogsys@padleft-\cogsys@padside\relax
    \linewidth=\hsize \textwidth=\hsize \columnwidth=\hsize
    \@parboxrestore\raggedright
    \usebeamerfont{block body}\usebeamercolor[fg]{block body}%
    \parindent=0pt
    \hbox{}\relax % the first baseline is \baselineskip below the top
    \ignorespaces}
% \begin{block} without braces takes the next token as the title: after an
% empty line that is \par, which also means no tab
\long\def\cogsys@settabtext#1{%
  \long\def\cogsys@tabtext{#1}%
  \ifx\cogsys@tabtext\cogsys@partoken \let\cogsys@tabtext\@empty \fi
  \ifblank{#1}{\let\cogsys@tabtext\@empty}{}}
\long\def\cogsys@partoken{\par}
\def\cogsys@boxend{%
    \par\unskip
    \vskip-\cogsys@linedepth\relax % bottom = last baseline
  \color@endgroup\egroup
  \cogsys@drawbox
  \prevdepth=0pt
  \vskip\cogsys@blockbelow
  \global\cogsys@afterblocktrue}
% The box: baseline at the outer top edge (height 0), so it hangs below the
% current position. The tab is overlaid on the top rule and takes no space.
\def\cogsys@drawbox{%
  \def\cogsys@tmp{excursus}%
  \ifx\cogsys@tabstyle\cogsys@tmp
    \expandafter\cogsys@drawexcursusbox
  \else
    \expandafter\cogsys@drawruledbox
  \fi}
\def\cogsys@drawruledbox{%
  \cogsys@dimc=\dimexpr\ht\cogsys@blockbox+\dp\cogsys@blockbox
    +\cogsys@padtop+\cogsys@padbottom-2\cogsys@blockrule\relax
  \vtop{\offinterlineskip
    % first line: top rule (below the baseline), then the tab on top of it
    \hbox to\cogsys@blockwidth{%
      \rlap{\color{cogsysink}\vrule\@width\cogsys@blockwidth
        \@height\z@\@depth\cogsys@blockrule}%
      \ifx\cogsys@tabtext\@empty\else\kern2.5mm\cogsys@tab\fi\hss}%
    \hbox to\cogsys@blockwidth{%
      {\color{cogsysink}\vrule\@width\cogsys@blockrule\@height\cogsys@dimc}%
      \kern\dimexpr\cogsys@padleft-\cogsys@blockrule\relax
      \vbox to\cogsys@dimc{%
        \kern\dimexpr\cogsys@padtop-\cogsys@blockrule\relax
        \copy\cogsys@blockbox\vss}%
      \hss
      {\color{cogsysink}\vrule\@width\cogsys@blockrule\@height\cogsys@dimc}}%
    {\color{cogsysink}\hrule\@height\cogsys@blockrule\@width\cogsys@blockwidth}}}
% tab, vertically centred on the top rule
\def\cogsys@tab{%
  \setbox\cogsys@box\hbox{\color@begingroup
    \cogsys@tabtextfont
    \def\cogsys@tmp{outlined}%
    \def\cogsys@tmpb{excursus}%
    \ifx\cogsys@tabstyle\cogsys@tmp
      \cogsys@canvascolor\color{cogsysink}%
      \cogsys@tagbox{\cogsys@tabtext}{bg}{solid}%
        {\cogsys@tababove}{\cogsys@tabbelow}{1.75mm}%
    \else\ifx\cogsys@tabstyle\cogsys@tmpb
      \usebeamercolor{excursus block}\color{cogsysink}%
      \cogsys@tagbox{\cogsys@tabtext}{bg}{dashed}%
        {\cogsys@tababove}{\cogsys@tabbelow}{1.75mm}%
    \else
      \color{cogsyspaper}%
      \cogsys@tagbox{\cogsys@tabtext}{cogsysink}{none}%
        {\cogsys@tababove}{\cogsys@tabbelow}{1.5mm}%
    \fi\fi\color@endgroup}%
  % how far the tab rises above the top rule (see Relaxed title gap)
  \ifcogsys@tabattop
    \global\cogsys@tabattopfalse
    \dimen@=\dimexpr(\ht\cogsys@box+\dp\cogsys@box-\cogsys@blockrule)/2\relax
    \ifdim\dimen@>\cogsys@topoverhang \global\cogsys@topoverhang=\dimen@ \fi
  \fi
  \smash{\lower\dimexpr(\ht\cogsys@box-\dp\cogsys@box+\cogsys@blockrule)/2\relax
    \box\cogsys@box}}

\setbeamertemplate{block begin}{%
  \cogsys@boxbegin{filled}{\insertblocktitle}{0.25mm}}
\setbeamertemplate{block end}{\cogsys@boxend}
\setbeamertemplate{block example begin}{%
  \cogsys@boxbegin{outlined}{\insertblocktitle}{0.25mm}}
\setbeamertemplate{block example end}{\cogsys@boxend}
\setbeamertemplate{block alerted begin}{%
  \cogsys@boxbegin{filled}{\insertblocktitle}{0.6mm}}
\setbeamertemplate{block alerted end}{\cogsys@boxend}

%% ---------------------------------------------------------------------------
%% Excursus block: an optional aside inside a normal slide
%% ---------------------------------------------------------------------------
%   \begin{excursusblock}{<title>} ... \end{excursusblock}
%   \begin{excursusblock}<2->{} ...     overlays as for block; an empty
%                                        title leaves just EXKURS in the tab
% The excursus slide in small: tinted fill (excursus canvas colour), the
% hatched edge marker as the left edge, a dashed outline instead of the
% solid rule and a dashed tab EXKURS · <title>.
\setbeamercolor{excursus block}{bg=cogsysexcursus}
\def\cogsys@pad@excursus{\cogsys@padleft=5mm} % 2 mm hatch + 3 mm gap
% dashed rules at block rule width, same rhythm as the dashed tag
% (0.5 mm on, 0.25 mm off)
\def\cogsys@hdashrule#1{\hbox to#1{%
  \cleaders\hbox to0.75mm{\hss\vrule\@width0.5mm\@height\cogsys@blockrule\hss}%
  \hfil}}
\def\cogsys@vdashrule#1{\vbox to#1{%
  \cleaders\vbox to0.75mm{\vss\hrule\@width\cogsys@blockrule\@height0.5mm\vss}%
  \vfil}}
% Same outer geometry as \cogsys@drawruledbox: baseline at the outer top
% edge, the box hangs below.
\def\cogsys@drawexcursusbox{%
  \cogsys@dimc=\dimexpr\ht\cogsys@blockbox+\dp\cogsys@blockbox
    +\cogsys@padtop+\cogsys@padbottom\relax
  \vtop{\offinterlineskip
    \hrule\@height\z@\@width\cogsys@blockwidth
    \cogsys@canvas{\cogsys@blockwidth}{\cogsys@dimc}{%
      \cogsys@put{\z@}{\z@}{tl}{\usebeamercolor{excursus block}%
        \cogsys@rect{\cogsys@blockwidth}{\cogsys@dimc}{bg}}%
      \cogsys@put{\z@}{\z@}{tl}{\cogsys@hatch{\cogsys@dimc}}%
      \cogsys@put{\z@}{\z@}{tl}{\color{cogsysink}%
        \cogsys@hdashrule{\cogsys@blockwidth}}%
      \cogsys@put{\z@}{\cogsys@dimc}{bl}{\color{cogsysink}%
        \cogsys@hdashrule{\cogsys@blockwidth}}%
      \cogsys@put{\cogsys@blockwidth}{\z@}{tr}{\color{cogsysink}%
        \cogsys@vdashrule{\cogsys@dimc}}%
      \cogsys@put{\cogsys@padleft}{\cogsys@padtop}{tl}{\copy\cogsys@blockbox}%
      \cogsys@put{\cogsys@padleft-0.75mm}{\z@}{bl}{\cogsys@tab}}}}
\newenvironment<>{excursusblock}[1]{%
  \begin{actionenv}#2%
    \ifblank{#1}%
      {\def\cogsys@exctab{\MakeUppercase{\cogsys@excursusname}}}%
      {\def\cogsys@exctab{\MakeUppercase{\cogsys@excursusname}\cogsys@tabsep#1}}%
    \cogsys@boxbegin{excursus}{\cogsys@exctab}{0.25mm}}%
  {\cogsys@boxend\end{actionenv}}

%% ---------------------------------------------------------------------------
%% Theorems: numbered tabs (DEF 2.1, EX 2.2, ...), one counter per section,
%% shared with algorithms.
%% ---------------------------------------------------------------------------
\@ifundefined{c@theorem}{\newcounter{theorem}}{}
\@addtoreset{theorem}{section}
\renewcommand\thetheorem{%
  \ifnum\c@section>0 \arabic{section}.\fi\arabic{theorem}}

% \cogsystheoremtag{<environment>}{<tag>}
\newcommand\cogsystheoremtag[2]{\@namedef{cogsys@tag@#1}{#2}}
\cogsystheoremtag{theorem}{THM}
\cogsystheoremtag{corollary}{COR}
\cogsystheoremtag{fact}{FACT}
\cogsystheoremtag{lemma}{LEM}
\cogsystheoremtag{problem}{PROB}
\cogsystheoremtag{solution}{SOL}
\cogsystheoremtag{definition}{DEF}
\cogsystheoremtag{definitions}{DEF}
\cogsystheoremtag{example}{EX}
\cogsystheoremtag{examples}{EX}
\cogsystheoremtag{Satz}{SATZ}
\cogsystheoremtag{Folgerung}{FOLG}
\cogsystheoremtag{Fakt}{FAKT}
\cogsystheoremtag{Loesung}{L\"OS}
\cogsystheoremtag{Beispiel}{BSP}
\cogsystheoremtag{Beispiele}{BSP}
\cogsystheoremtag{algorithm}{ALG}

\def\cogsys@tabsep{\ \textperiodcentered\ }
% remember the environment name (beamer wraps theorems in actionenv)
\def\cogsys@thmenv{}
\let\cogsys@orig@thm\@thm
\def\@thm{\let\cogsys@thmenv\@currenvir\cogsys@orig@thm}
\def\cogsys@theoremtag{%
  \@ifundefined{cogsys@tag@\cogsys@thmenv}%
    {\MakeUppercase{\inserttheoremname}}%
    {\@nameuse{cogsys@tag@\cogsys@thmenv}}}
\setbeamertemplate{theorem begin}{%
  \def\cogsys@tmp{exampleblock}%
  \cogsys@boxbegin
    {\ifx\inserttheoremblockenv\cogsys@tmp outlined\else filled\fi}%
    {\cogsys@theoremtag\inserttheoremnumber
     \ifx\inserttheoremaddition\@empty\else
       \cogsys@tabsep\inserttheoremaddition\fi}%
    {0.25mm}}
\setbeamertemplate{theorem end}{\cogsys@boxend}
\setbeamertemplate{proof begin}{%
  \cogsys@boxbegin{outlined}{\insertproofname}{0.25mm}}
\setbeamertemplate{proof end}{\cogsys@boxend}
\setbeamertemplate{qed symbol}{\rule{1.2mm}{1.2mm}}
% beamer's \inserttheoremnumber has a leading space; keep a single one.

%% ---------------------------------------------------------------------------
%% Footnotes and on-slide references
%% ---------------------------------------------------------------------------
% Footnotes sit at the bottom of the text area, 10 mm above the paper edge,
% behind an 11 mm hairline. Full references (\framebib, \framecite) follow
% after the footnotes, unnumbered, with a 2em hanging indent; references
% cited in the frame title come first.
\renewcommand\footnoterule{%
  \kern-1mm{\color{cogsysink}\hrule width 11mm height 0.19mm}\kern1.25mm}
\newif\ifcogsys@bibnote
\newif\ifcogsys@firstbib
\setbeamertemplate{footnote}{%
  \parindent=0pt \parfillskip=0pt plus 1fil
  \usebeamerfont{footnote}\usebeamercolor[fg]{footnote}%
  \ifcogsys@bibnote
    \ifcogsys@firstbib\global\cogsys@firstbibfalse\vskip1.5mm\fi
    \raggedright\hangindent=2em \hangafter=1
    \insertfootnotetext\par
  \else
    \raggedright\leftskip=3mm
    \noindent\llap{\hbox to3mm{%
      {\usebeamerfont{footnote mark in footnote}\usebeamercolor[fg]{footnote mark}%
       \raise0.1mm\hbox{\@thefnmark}}\hss}}%
    \insertfootnotetext\par
  \fi}
\setlength\footnotesep{7.9pt}
\def\@makefnmark{\hbox{\kern0.15mm\raise0.75ex\hbox{%
  \usebeamercolor[fg]{footnote mark}\usebeamerfont*{footnote mark}\@thefnmark}}}

% Full references on the slide (requires biblatex).
%   \framebib{<keys>}       add full entries to the footnote region
%   \framecite{<key>}       \textcite + full entry
%   \frameparencite{<key>}  \parencite + full entry
\def\cogsys@bibkeys{}
\def\cogsys@titlebibkeys{}
\newif\ifcogsys@titlebib
% \cogsys@addbibkey<list>{<key>}: append <key> to <list> unless present
\def\cogsys@addbibkey#1#2{%
  \edef\cogsys@tmp{\noexpand\in@{,#2,}{,#1,}}%
  \cogsys@tmp
  \ifin@\else\xdef#1{\ifx#1\@empty\else#1,\fi#2}\fi}
\newcommand<>\framebib[1]{%
  \@ifundefined{blx@citeargs}{%
    \PackageError{beamerthemecogsys}{\string\framebib\space needs biblatex}{}}{}%
  \@for\cogsys@key:=#1\do{%
    \ifcogsys@titlebib
      \cogsys@addbibkey\cogsys@titlebibkeys\cogsys@key
    \else
      \cogsys@addbibkey\cogsys@bibkeys\cogsys@key
    \fi
    \ifin@\else
      \expandafter\gdef\csname cogsys@bibspec@\cogsys@key\endcsname{#2}%
    \fi}}
\newcommand\framecite[2][]{\textcite[#1]{#2}\framebib{#2}}
\newcommand\frameparencite[2][]{\parencite[#1]{#2}\framebib{#2}}
\def\cogsys@flushbibs{%
  % continuation pages of allowframebreaks frames: the title's entries are
  % already in the footnote box from the first page
  \ifnum\beamer@autobreakcount>1 \global\let\cogsys@titlebibkeys\@empty\fi
  % title references first
  \let\cogsys@tmpkeys\cogsys@bibkeys
  \global\let\cogsys@bibkeys\cogsys@titlebibkeys
  \global\let\cogsys@titlebibkeys\@empty
  \@for\cogsys@key:=\cogsys@tmpkeys\do{%
    \cogsys@addbibkey\cogsys@bibkeys\cogsys@key}%
  \ifx\cogsys@bibkeys\@empty\else
    \global\cogsys@firstbibtrue
    \global\cogsys@bibnotetrue
    \begingroup
    \def\@thefnmark{}% beamer's footnote code expects a mark
    \@for\cogsys@key:=\cogsys@bibkeys\do{%
      \expandafter\let\expandafter\cogsys@spec
        \csname cogsys@bibspec@\cogsys@key\endcsname
      \edef\cogsys@next{\noexpand\beamer@framefootnotetext\cogsys@spec
        {\noexpand\cogsys@bibentry{\cogsys@key}}}%
      \cogsys@next}%
    \endgroup
    \global\cogsys@bibnotefalse
    \global\let\cogsys@bibkeys\@empty
  \fi}
\def\cogsys@bibentry#1{\fullcite{#1}}
% after the frame title (beamer typesets it after the body), right before
% beamer places the footnotes; then measure the room for algorithms (see
% Algorithms)
\pretocmd\beamer@autobreakframebox{\cogsys@flushbibs\cogsys@algmeasure}{}%
  {\PackageWarningNoLine{beamerthemecogsys}{Could not patch beamer's footnotes}}
% \beamer@framefootnotetext takes the overlay spec before the text
\def\cogsys@bibspec@{}

