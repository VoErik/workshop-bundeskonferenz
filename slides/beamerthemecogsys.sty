\def\cogsys@pagekind{frame}
\AddToHook{env/beamer@framepauses/begin}{%
  \gdef\cogsys@pagekind{frame}%
  \global\cogsys@bodytoptrue
  \global\cogsys@afterblockfalse
  \setcounter{footnote}{0}%
