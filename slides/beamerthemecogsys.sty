% \cogsys@choicekey{<key>}{<allowed values>}{<macro>}
\def\cogsys@choicekey#1#2#3{%
  \define@key{cogsys}{#1}{%
    \in@{,##1,}{,#2,}%
    \ifin@\def#3{##1}\else
      \PackageWarning{beamerthemecogsys}{Invalid value `##1' for option `#1'}%
    \fi}}
% \cogsys@boolkey{<key>}: true/false, bare key means true
\def\cogsys@boolkey#1{%
  \define@key{cogsys}{#1}[true]{%
    \@ifundefined{cogsys@#1##1}%
      {\PackageWarning{beamerthemecogsys}{Invalid value `##1' for option `#1'}}%
      {\csname cogsys@#1##1\endcsname}}}
\cogsys@choicekey{flag}{pride,palestine,trans,none}\cogsys@flag
\cogsys@choicekey{font}{atkinson,none}\cogsys@font
\define@key{cogsys}{algorithms}[pseudocode]{%
  \def\cogsys@tmp{#1}\def\cogsys@tmpb{true}%
  \ifx\cogsys@tmp\cogsys@tmpb\def\cogsys@tmp{pseudocode}\fi
  \expandafter\in@\expandafter{\expandafter,\cogsys@tmp,}{,pseudocode,pseudocodex,false,}%
  \ifin@\let\cogsys@algorithms\cogsys@tmp\else
    \PackageWarning{beamerthemecogsys}{Invalid value `#1' for option `algorithms'}%
  \fi}
\cogsys@boolkey{pagenumbers}
\cogsys@boolkey{pagetotal}
\cogsys@boolkey{shortcourse}
\cogsys@boolkey{sectionpages}
\cogsys@boolkey{listings}
\cogsys@boolkey{tracking}
\cogsys@boolkey{monoscale}
\cogsys@boolkey{titlerelax}
\define@key{cogsys}{titlerelaxgap}{\cogsys@titlerelaxgap=#1\relax}
\define@key{cogsys}{unilogo}{\def\cogsys@unilogo{#1}}
\define@key{cogsys}{chairlogo}{\def\cogsys@chairlogo{#1}}
% Labels. A label set here wins over the language default, in any key order.
% \cogsys@namekey{<name>}: keys `<name> name' and `<name>name'
\def\cogsys@namekey#1{%
  \define@key{cogsys}{#1 name}{\@namedef{cogsys@#1name}{##1}%
    \@namedef{cogsys@#1name@set}{}}%
  \define@key{cogsys}{#1name}{\setkeys{cogsys}{#1 name={##1}}}}
\cogsys@namekey{lecture}
\cogsys@namekey{essential}
\cogsys@namekey{excursus}
% language=en|ger: default labels (see "Language" at the end of the file).
% Applied at the end of the theme, so all defaults it replaces exist.
\def\cogsys@language{en}
\define@key{cogsys}{language}{%
  \in@{,#1,}{,en,ger,}%
  \ifin@
    \def\cogsys@language{#1}%
    \ifdefined\cogsys@applylanguage\cogsys@applylanguage\fi
  \else
    \PackageWarning{beamerthemecogsys}{Invalid value `#1' for option `language'}%
  \fi}
% options of the previous theme version
\define@key{cogsys}{shortlec}[]{\cogsys@shortcoursetrue}
\define@key{cogsys}{suppress_pagenum}[]{\cogsys@pagenumbersfalse}

% \cogsysset{<key=value list>}: like \setkeys, but unknown keys only warn
\newcommand\cogsysset[1]{%
  \@for\cogsys@kv:=#1\do{%
    \ifx\cogsys@kv\@empty\else
      \expandafter\cogsys@getkey\cogsys@kv=\@nil
      \@ifundefined{KV@cogsys@\cogsys@key}%
        {\PackageWarning{beamerthemecogsys}%
          {Unknown theme option `\cogsys@key'}}%
        {\edef\cogsys@tmp{\noexpand\setkeys{cogsys}%
           {\unexpanded\expandafter{\cogsys@kv}}}\cogsys@tmp}%
    \fi}}
\def\cogsys@getkey#1=#2\@nil{\KV@@sp@def\cogsys@key{#1}}

% Feed the package option list to \cogsysset.
\DeclareOption*{}
\ProcessOptions\relax
\expandafter\let\expandafter\cogsys@optlist
  \csname opt@\@currname.\@currext\endcsname
\ifx\cogsys@optlist\relax\else
  \expandafter\cogsysset\expandafter{\cogsys@optlist}
\fi

