      \cogsys@ifkind{essential}{%
        {\color{cogsyspaper}\bfseries
         \cogsys@tagbox{\MakeUppercase{\cogsys@essentialname}}%
           {cogsysink}{none}{0.94mm}{1.0mm}{1.5mm}}\hskip2mm}%
      \cogsys@ifkind{excursus}{%
        {\color{cogsysink}\bfseries
         \cogsys@tagbox{\MakeUppercase{\cogsys@excursusname}}%
           {}{dashed}{0.94mm}{1.0mm}{1.5mm}}\hskip2mm}%
