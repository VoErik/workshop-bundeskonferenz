      {\cogsys@put{\z@}{\z@}{tl}{\cogsys@rect{2mm}{\paperheight}{cogsysink}}}%
    \cogsys@ifkind{excursus}{\cogsys@put{\z@}{\z@}{tl}{\cogsys@hatchbar}}%
    \csname cogsys@draw@\cogsys@pagekind\endcsname}}

\def\cogsys@draw@frame{}

% Hatched edge marker, 2 mm wide: 45 degree lines (top left to bottom right),
% 0.375 mm wide, 1.25 mm apart. Each line spans the strip exactly; the
% lines are repeated down the page with \cleaders.
% \cogsys@hatch{<height>} draws the strip at any height (excursus blocks).
\def\cogsys@hatchbar{\cogsys@hatch\paperheight}
\def\cogsys@hatch#1{%
  \vbox to#1{\offinterlineskip
    \cleaders\vbox to1.7678mm{\vss
      \hbox to2mm{\hss\smash{\rotatebox[origin=c]{-45}{%
        \color{cogsysink}\vrule\@width2.8284mm\@height0.1875mm\@depth0.1875mm}}%
      \hss}\vss}\vfill}}

% Mono caps label items, separated by 3.5 mm
\def\cogsys@labelitem#1{%
  \ifcogsys@firstlabel\global\cogsys@firstlabelfalse\else\hskip3.5mm\fi
  \MakeUppercase{#1}}
\newif\ifcogsys@firstlabel

% Multi-line text measured by baselines: \cogsys@vtop{<setup>}{<text>}
% leaves the box in \cogsys@box and the distance between its first and last
% baseline in \cogsys@dimb.
\def\cogsys@vtop#1#2{%
  \setbox\cogsys@box\vbox{\hsize=\dimexpr\paperwidth-20mm\relax
    \color@begingroup\noindent#1\raggedright#2\par\color@endgroup}%
  \cogsys@dimb=\ht\cogsys@box
  \setbox\cogsys@box\vtop{\hsize=\dimexpr\paperwidth-20mm\relax
    \color@begingroup\noindent#1\raggedright#2\par\color@endgroup}%
  \advance\cogsys@dimb-\ht\cogsys@box}

\newbox\cogsys@titlebox \newdimen\cogsys@titleextra
\newbox\cogsys@subbox   \newdimen\cogsys@subextra
\newbox\cogsys@authbox
\def\cogsys@prepare@frame{}
\def\cogsys@prepare@title{%
  \cogsys@vtop{\usebeamerfont{title}\usebeamercolor[fg]{title}\cogsys@track{-20}}%
              {\inserttitle}%
  \setbox\cogsys@titlebox\box\cogsys@box \cogsys@titleextra=\cogsys@dimb
  \cogsys@vtop{\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\cogsys@medium}%
              {\insertsubtitle}%
  \setbox\cogsys@subbox\box\cogsys@box \cogsys@subextra=\cogsys@dimb
  \cogsys@vtop{\usebeamerfont{author}\usebeamercolor[fg]{author}}{\insertauthor}%
  \setbox\cogsys@authbox\box\cogsys@box}
\def\cogsys@prepare@section{%
  \cogsys@vtop{\usebeamerfont{section title}\usebeamercolor[fg]{frametitle}%
               \cogsys@track{-20}}{\secname}% full title; the short one is for the label line
  \setbox\cogsys@titlebox\box\cogsys@box \cogsys@titleextra=\cogsys@dimb}

\def\cogsys@draw@title{%
  % label line: course + term, lecture number, date
  \cogsys@put{10mm}{9.86mm}{bl}{%
    \usebeamerfont{label line}\usebeamercolor[fg]{label line}%
    \global\cogsys@firstlabeltrue
    \edef\cogsys@tmp{\insertshortcourse\ifx\cogsys@semester\@empty\else\ \cogsys@semester\fi}%
    \ifx\cogsys@tmp\@empty\else\cogsys@labelitem{\cogsys@tmp}\fi
    \ifx\cogsys@lecturenumber\@empty\else
      \cogsys@labelitem{\cogsys@lecturename\ \insertlecturenumber}\fi
    \ifx\insertdate\@empty\else\cogsys@labelitem{\insertdate}\fi}%
  % title: last baseline 47.5 mm from the top for a one-line title and
  % subtitle; extra lines push the block upwards, keeping the bottom fixed
  \cogsys@dima=\dimexpr47.5mm-\cogsys@titleextra\relax
  \ifx\insertsubtitle\@empty\else\advance\cogsys@dima-\cogsys@subextra\fi
  \cogsys@put{10mm}{\cogsys@dima}{bl}{\copy\cogsys@titlebox}%
  \advance\cogsys@dima\cogsys@titleextra
  % flag underline 14 x 1 mm
  \advance\cogsys@dima4.94mm
  \cogsys@put{10mm}{\cogsys@dima}{tl}{\cogsys@flagbar{14mm}{1mm}}%
  \advance\cogsys@dima1mm
  \ifx\insertsubtitle\@empty\else
    \advance\cogsys@dima7.25mm
    \cogsys@put{10mm}{\cogsys@dima}{bl}{\copy\cogsys@subbox}%
    \advance\cogsys@dima\cogsys@subextra
    \advance\cogsys@dima1.44mm
  \fi
  \ifx\insertauthor\@empty\else
    \advance\cogsys@dima7.25mm
    \cogsys@put{10mm}{\cogsys@dima}{bl}{\copy\cogsys@authbox}%
  \fi
}

\def\cogsys@draw@section{%
  \cogsys@put{10mm}{40.19mm}{bl}{%
    \usebeamerfont{section number}\usebeamercolor[fg]{label line}%
    \S\insertsectionnumber}%
  \cogsys@dima=51.06mm
  \cogsys@put{10mm}{\cogsys@dima}{bl}{\copy\cogsys@titlebox}%
  \advance\cogsys@dima\cogsys@titleextra
  \advance\cogsys@dima4.94mm
  \cogsys@put{10mm}{\cogsys@dima}{tl}{\cogsys@flagbar{14mm}{1mm}}%
}

\setbeamertemplate{title page}{\gdef\cogsys@pagekind{title}}
\setbeamertemplate{section page}{\gdef\cogsys@pagekind{section}}
% Section pages: on or off for the whole document (option sectionpages), and
% per section with the optional argument of \section:
%   \section[noframe]{Name}  no section page for this section
%   \section[frame]{Name}    section page even if sectionpages=false
% (any other optional argument is the short title, as usual)
\newif\ifcogsys@thissectionpage
\def\cogsys@str@noframe{noframe}
\def\cogsys@str@frame{frame}
\let\cogsys@orig@beamer@section\beamer@section
\long\def\beamer@section[#1]#2{%
  \ifcogsys@sectionpages
    \global\cogsys@thissectionpagetrue
  \else
    \global\cogsys@thissectionpagefalse
  \fi
  \def\cogsys@tmp{#1}%
  \ifx\cogsys@tmp\cogsys@str@noframe
    \global\cogsys@thissectionpagefalse
    \def\cogsys@tmp{\cogsys@orig@beamer@section[#2]{#2}}%
  \else\ifx\cogsys@tmp\cogsys@str@frame
    \global\cogsys@thissectionpagetrue
    \def\cogsys@tmp{\cogsys@orig@beamer@section[#2]{#2}}%
  \else
    \def\cogsys@tmp{\cogsys@orig@beamer@section[#1]{#2}}%
  \fi\fi
  \cogsys@tmp}
\def\cogsys@sectionframe{\begin{frame}\sectionpage\end{frame}}
\AtBeginSection{%
  \ifcogsys@thissectionpage\expandafter\cogsys@sectionframe\fi}
% The slide of the first \tableofcontents, the target of the section label
