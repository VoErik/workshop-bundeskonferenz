  \global\let\cogsys@bibkeys\@empty
  \global\let\cogsys@titlebibkeys\@empty
  \global\c@cogsys@alginslide=0\relax
  % see Relaxed title gap
  \global\cogsys@relaxapplied=\z@ \global\cogsys@relaxlimit=\z@
  \global\cogsys@titlerule=\z@
  \global\cogsys@colsfirstfalse \global\cogsys@colinktop=\maxdimen
  \global\cogsys@topoverhang=\z@ \global\cogsys@tabattopfalse}
