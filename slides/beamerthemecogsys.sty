%% ---------------------------------------------------------------------------
%% Inline code and listings
%% ---------------------------------------------------------------------------
\newcommand\code[1]{\texttt{#1}}
\newcommand\bare[1]{\texttt{#1}}
\newenvironment{codeblock}[1]{%
  \cogsys@boxbegin{outlined}{#1}{0.25mm}\ttfamily}{\cogsys@boxend}

\ifcogsys@listings
  \IfFileExists{listings.sty}{}{\cogsys@listingsfalse}
\fi
\ifcogsys@listings
    \RequirePackage{listings}
    \renewcommand\code[1]{\lstinline[basicstyle=\ttfamily]{#1}}
    \renewcommand\bare[1]{\lstinline[basicstyle=\ttfamily]{#1}}
    % Listing text: 7.80 pt at the 10 pt body, scaled with the text size
    % active before the listing (\tiny, \scriptsize, ...); the leading is
    % always 1.6 times that size. Line numbers keep their ratio to it.
    \def\cogsys@lstfont{%
      \edef\cogsys@lstsize{\strip@pt\dimexpr\f@size pt*78/100\relax}%
      \cogsys@mono{\cogsys@lstsize}{1.6}}
    \def\cogsys@lstsize{7.80}
    \lstset{
      basicstyle=\cogsys@lstfont,
      columns=fullflexible, keepspaces=true, upquote=true,
      breaklines=true, tabsize=4, showstringspaces=false,
      keywordstyle=\bfseries, commentstyle=\color{cogsysgrey777},
      stringstyle=\color{cogsysgrey444},
      numberstyle=\cogsys@mono{\strip@pt\dimexpr\cogsys@lstsize pt*602/780\relax}{1.0}%
        \color{cogsysgrey888},
      numbersep=2mm, xleftmargin=0pt, aboveskip=0pt, belowskip=0pt,
    }
\fi

%% ---------------------------------------------------------------------------
%% Algorithms: algorithmic in a tabbed box, font shrinks to fit
%% ---------------------------------------------------------------------------
% \begin{algo}[<options>]{<caption>}
%   \Procedure{Lock}{i} ... \EndProcedure
% \end{algo}
% Options: width=<dim> (default \linewidth; a narrower box follows
%            \centering, \raggedleft and the center environment),
%          minsize=<pt> (smallest size when fitting, default 5 = \tiny),
%          maxheight=<dim> (fit into this height instead of the room left on
%            the slide), size=<pt> (fixed size, no fitting),
%          numbers=true|false.
%
% Theme option algorithms=
%   pseudocode  (default) algpseudocode from the algorithmicx bundle; the
%               theme draws the indent guides itself. No TikZ needed.
%   pseudocodex algpseudocodex (more features, but needs TikZ).
%   false       no algorithm support.
% A package the user loads takes precedence, before or after the theme;
% algpseudocodex wins over algpseudocode.
\def\cogsys@str@pseudocode{pseudocode}
\def\cogsys@str@pseudocodex{pseudocodex}
\def\cogsys@str@false{false}
% packages loaded before the theme (for those loaded after it, see the end
% of the preamble below)
\@ifpackageloaded{algpseudocode}{\let\cogsys@algorithms\cogsys@str@pseudocode}{}
\@ifpackageloaded{algpseudocodex}{\let\cogsys@algorithms\cogsys@str@pseudocodex}{}
\ifx\cogsys@algorithms\cogsys@str@pseudocodex
  \IfFileExists{algpseudocodex.sty}{}{%
    \let\cogsys@algorithms\cogsys@str@pseudocode
    \PackageWarningNoLine{beamerthemecogsys}{algpseudocodex not found;
      using algpseudocode instead}}
\fi
\ifx\cogsys@algorithms\cogsys@str@pseudocode
  \IfFileExists{algpseudocode.sty}{}{%
    \let\cogsys@algorithms\cogsys@str@false
    \PackageWarningNoLine{beamerthemecogsys}{algpseudocode not found;
      the `algo' environment is disabled}}
\fi

\def\cogsys@alglabelwidth{1.2em}\def\cogsys@alglabelsep{0.5em}
% hooks in algorithmicx, used by the algpseudocode setup; no-ops otherwise
\def\cogsys@algguides{}
\def\cogsys@algnoline{\nointerlineskip}
% run in trial builds (see Fitting)
\def\cogsys@algdraftsetup{}

% algpseudocode: the theme draws the indent guides
\def\cogsys@algsetup@pseudocode{%
  \algrenewcommand\algorithmiccomment[1]{%
    \hfill{\color{cogsysgrey555}$\triangleright$~##1}}%
  % Indent guides: every line of a block body gets one rule segment per
  % open block; segments of consecutive lines join into a continuous line.
  \expandafter\patchcmd\csname ALG@doentity\endcsname
    {\noindent\hskip\ALG@tlm}{\noindent\cogsys@algguides\hskip\ALG@tlm}{}%
    {\PackageWarningNoLine{beamerthemecogsys}{Could not patch algorithmicx;
      no indent guides}}%
  % noend: end entities have no text but still start an empty line, which
  % adds the depth of the previous line; take that depth back
  \expandafter\patchcmd\csname ALG@doentity\endcsname
    {\item[]\nointerlineskip}{\item[]\cogsys@algnoline}{}%
    {\PackageWarningNoLine{beamerthemecogsys}{Could not patch algorithmicx;
      blocks may get extra space}}%
  \let\cogsys@algguides\cogsys@algguides@on
  \let\cogsys@algnoline\cogsys@algnoline@on}
\def\cogsys@algnoline@on{\ifdim\prevdepth>\z@\vskip-\prevdepth\fi
  \nointerlineskip}
\def\cogsys@algguides@on{%
  \ifx\ALG@text\ALG@x@notext\else
    \cogsys@dima=0.12em
    \count@=\z@
    \loop\ifnum\count@<\c@ALG@nested
      \rlap{\kern\cogsys@dima\color{cogsysrule}%
        \vrule\@width0.19mm\@height.7\baselineskip\@depth.3\baselineskip}%
      \advance\count@\@ne
      \advance\cogsys@dima\csname ALG@ind@\the\count@\endcsname\relax
    \repeat
  \fi}
% algpseudocodex: its own (TikZ) indent lines in the theme's colours.
% noEnd and indLines are package options (the theme passes them when it
% loads the package); options of a user's \usepackage are kept.
\def\cogsys@algsetup@pseudocodex{%
  \algpx@italicCommentsfalse \algpx@rightCommentstrue
  \def\algpx@commentColor{cogsysgrey555}%
  \tikzset{algpxIndentLine/.style={draw=cogsysrule, line width=0.19mm}}%
  % straight indent guides without the end tick (after the package's own
  % hook, which sets the length)
  \AtBeginEnvironment{algorithmic}{\setlength{\algpx@indXLineLength}{0pt}}%
  % the lines are drawn from positions of the previous run; only the final
  % build may set them
  \def\cogsys@algdraftsetup{\algpx@indLinesfalse}}
% both: line numbers, procedure names (per algorithmicx language)
\def\cogsys@algsetup@common{%
  \algrenewcommand\textproc{}%
  \algrenewcommand\alglinenumber[1]{%
    {\cogsys@mono{\cogsys@alglnsize}{1.0}\color{cogsysgrey888}##1}}}
% algorithmicx hard-codes the line number column; make it adjustable
\def\cogsys@algsetup@base{%
  \expandafter\patchcmd\csname\string\algorithmic\endcsname{\labelwidth 1.2em}{\labelwidth\cogsys@alglabelwidth}{}%
    {\PackageWarningNoLine{beamerthemecogsys}{Could not patch algorithmic (1)}}%
  \expandafter\patchcmd\csname\string\algorithmic\endcsname{\labelsep 0.5em}{\labelsep\cogsys@alglabelsep}{}%
    {\PackageWarningNoLine{beamerthemecogsys}{Could not patch algorithmic (2)}}%
  \expandafter\patchcmd\csname\string\algorithmic\endcsname
    {\topsep 0.2em}{\topsep\z@}{}{}}

\ifx\cogsys@algorithms\cogsys@str@pseudocodex
  \@ifpackageloaded{algpseudocodex}{}{%
    \RequirePackage[noEnd=true, indLines=true]{algpseudocodex}}
  \cogsys@algsetup@pseudocodex
\fi
\ifx\cogsys@algorithms\cogsys@str@pseudocode
  \@ifpackageloaded{algpseudocode}{}{\RequirePackage[noend]{algpseudocode}}
  \cogsys@algsetup@pseudocode
\fi
\ifx\cogsys@algorithms\cogsys@str@false\else
  \cogsys@algsetup@base
  \cogsys@algsetup@common
\fi
% Packages loaded after the theme. algpseudocodex defines its own
% algorithmicx language, so the settings above have to be made again for it.
\AddToHook{begindocument/before}{%
  \let\cogsys@tmp\cogsys@algorithms
  \@ifpackageloaded{algpseudocode}{\let\cogsys@tmp\cogsys@str@pseudocode}{}%
  \@ifpackageloaded{algpseudocodex}{\let\cogsys@tmp\cogsys@str@pseudocodex}{}%
  \ifx\cogsys@tmp\cogsys@algorithms
    % algpseudocode loaded after algpseudocodex switches the language back
    \ifx\cogsys@algorithms\cogsys@str@pseudocodex
      \@ifpackageloaded{algpseudocode}{%
        \alglanguage{pseudocodex}\cogsys@algsetup@common}{}%
    \fi
  \else
    \ifx\cogsys@algorithms\cogsys@str@false \cogsys@algsetup@base \fi
    % the guides of the algpseudocode setup would be drawn as well
    \def\cogsys@algguides{}%
    \def\cogsys@algnoline{\nointerlineskip}%
    \let\cogsys@algorithms\cogsys@tmp
    \csname cogsys@algsetup@\cogsys@algorithms\endcsname
    \cogsys@algsetup@common
  \fi}

\newif\ifcogsys@algnumbers
\def\cogsys@algsize{8.86}    % largest size; also the size before fitting
\def\cogsys@algleading{1.5}
\def\cogsys@alglnsize{6.91}  % line numbers: 78 %, like the list markers
\def\cogsys@algminsize{5}
\def\cogsys@algwidth{\linewidth}
\define@key{cogsysalgo}{width}{\def\cogsys@algwidth{#1}}
\define@key{cogsysalgo}{minsize}{\def\cogsys@algminsize{#1}}
\define@key{cogsysalgo}{maxheight}{\def\cogsys@algmaxheight{#1}}
\define@key{cogsysalgo}{size}{\def\cogsys@algfixedsize{#1}}
\define@key{cogsysalgo}{numbers}[true]{\csname cogsys@algnumbers#1\endcsname}

% Fitting. The body is typeset at trial sizes until the largest size
% <= 8.86 pt is found whose height fits into the room the algorithm has on
% the slide. That room is measured when the slide is complete: the free
% space of the frame (everything else on it, footnotes and references
% included) plus the height of the algorithm; the smallest room over the
% slides of a frame is written to the .aux file (\cogsys@algroom). It does
% not depend on the size of the algorithm, so the document settles after
% two runs. Heights are measured, not extrapolated, because lines that wrap
% at one size may not wrap at another.
% records of earlier theme versions in old .aux files
\def\cogsys@algrecord#1#2{}
\def\cogsys@algpos#1#2{}
\def\cogsys@algroom#1#2{\global\@namedef{cogsys@algroom@#1}{#2}}
\newtoks\cogsys@algbody
\newdimen\cogsys@algavail % room for the box contents
\newdimen\cogsys@alght    % height of the last trial
\newdimen\cogsys@algtrial % size of the last trial
\newdimen\cogsys@alglo    % largest size that fits
\newdimen\cogsys@alghi    % smallest size that does not fit
\newdimen\cogsys@algfloor % smallest size
\newdimen\cogsys@algnatural % height at the largest size
\newcount\cogsys@algtries
\newif\ifcogsys@algknown
\newif\ifcogsys@algdraft

\NewDocumentEnvironment{algo}{O{} m +b}{%
  \ifx\cogsys@algorithms\cogsys@str@false
    \PackageError{beamerthemecogsys}{The algo environment needs
      algpseudocode}{Install algorithmicx (algpseudocode) or remove the
      algo environment.}%
  \fi
  \cogsys@blockstart
  \cogsys@algnumberstrue
  \let\cogsys@algmaxheight\relax \let\cogsys@algfixedsize\relax
  \setkeys{cogsysalgo}{#1}%
  \refstepcounter{theorem}%
  \stepcounter{cogsys@alginslide}%
  % the same algorithm on all slides of a frame (overlays) gets one size
  \edef\cogsys@algid{\beamer@framestartpage-\the\c@cogsys@alginslide}%
  \def\cogsys@tabtext{\cogsys@tag@algorithm~\thetheorem
    \if\relax\detokenize{#2}\relax\else\cogsys@tabsep#2\fi}%
  \cogsys@blockwidth=\dimexpr\cogsys@algwidth\relax
  \cogsys@padtop=1.91mm \cogsys@padbottom=3.57mm
  \cogsys@padside=3mm \cogsys@padleft=1.75mm
  % --- typeset the body at the chosen font size
  \cogsys@algbody{#3}%
  \cogsys@algsave
  \ifx\cogsys@algfixedsize\relax
    \cogsys@algfit
  \else
    \cogsys@algbuild\cogsys@algfixedsize
  \fi
  \cogsys@algnote
  \def\cogsys@tabstyle{filled}%
  \cogsys@blockrule=0.25mm
  \def\cogsys@tababove{1.2mm}\def\cogsys@tabbelow{1.24mm}%
  \cogsys@algplace
  \prevdepth=0pt
  \vskip\cogsys@blockbelow
  \global\cogsys@afterblocktrue
}{}
% A narrower box follows the alignment of the surrounding text (\centering,
% \raggedleft, center environment); otherwise it sits on the left.
\def\cogsys@algplace{%
  \ifdim\cogsys@blockwidth<\linewidth
    \hbox to\linewidth{%
      \hskip\leftskip\cogsys@drawbox\hskip\rightskip
      \ifdim\gluestretch\leftskip=\z@
        \ifdim\gluestretch\rightskip=\z@\hfil\fi
      \fi}%
  \else
    \cogsys@drawbox
  \fi}
% \cogsys@algbuild{<size>}: typeset the body into \cogsys@blockbox at <size>
% pt and measure it
\def\cogsys@algbuild#1{%
  \cogsys@algrestore
  \edef\cogsys@size{#1}%
  \setbox\cogsys@blockbox\vbox\bgroup\color@begingroup
    \ifcogsys@algdraft\cogsys@algdraftsetup\fi
    \hsize=\dimexpr\cogsys@blockwidth-\cogsys@padleft-\cogsys@padside\relax
    \linewidth=\hsize \textwidth=\hsize \columnwidth=\hsize
    \@parboxrestore
    \normalfont\usebeamerfont{algorithm}%
    \cogsys@fs{\cogsys@size}{\cogsys@algleading}%
    \cogsys@dima=\cogsys@size pt\relax
    \edef\cogsys@alglnsize{\strip@pt\dimexpr\cogsys@dima*78/100\relax}%
    \edef\algorithmicindent{\the\dimexpr\cogsys@dima*996/886\relax}% 3.5 mm
    \edef\cogsys@alglabelwidth{\the\dimexpr\cogsys@dima*1138/886\relax}% 4 mm
    \edef\cogsys@alglabelsep{\the\dimexpr\cogsys@dima*569/886\relax}%   2 mm
    \color{cogsysink}%
    \let\gets\cogsys@gets
    \hbox{}\relax
    \ifcogsys@algnumbers\begin{algorithmic}[1]\else\begin{algorithmic}\fi
    \the\cogsys@algbody
    \end{algorithmic}%
    \par\ifdim\prevdepth>0pt \vskip-\prevdepth\fi
  \color@endgroup\egroup
  \cogsys@alght=\dimexpr\ht\cogsys@blockbox+\dp\cogsys@blockbox\relax}
% available height: room from the .aux file, or maxheight
\def\cogsys@algfit{%
  \cogsys@algknowntrue
  \ifx\cogsys@algmaxheight\relax
    \expandafter\let\expandafter\cogsys@tmp
      \csname cogsys@algroom@\cogsys@algid\endcsname
    \ifx\cogsys@tmp\relax
      \cogsys@algknownfalse % first run
    \else
      \cogsys@algavail=\cogsys@tmp\relax
    \fi
    \def\cogsys@algtol{1mm}% the breathing room, see \cogsys@algmeasure
  \else
    \cogsys@algavail=\dimexpr\cogsys@algmaxheight
      -5.48mm\relax % box padding and rules
    \def\cogsys@algtol{0.1pt}%
  \fi
  \cogsys@algfloor=\cogsys@algminsize pt\relax
  \ifdim\cogsys@algfloor>\cogsys@algsize pt\relax
    \cogsys@algfloor=\cogsys@algsize pt\relax
  \fi
  \cogsys@algdrafttrue
  \cogsys@algtrial=\cogsys@algsize pt\relax
  \cogsys@algbuild\cogsys@algsize
  \cogsys@algnatural=\cogsys@alght
  \ifcogsys@algknown
    \ifdim\cogsys@alght>\cogsys@algavail \cogsys@algshrink \fi
  \fi
  \cogsys@algdraftfalse
  \ifx\cogsys@algorithms\cogsys@str@pseudocodex
    \cogsys@algbuild{\strip@pt\cogsys@algtrial}% the final build
  \fi
  \ifcogsys@algknown
    \ifdim\cogsys@alght>\dimexpr\cogsys@algavail+\cogsys@algtol\relax
      \PackageWarning{beamerthemecogsys}{Algorithm \thetheorem\space does not
        fit, even at the\MessageBreak smallest size
        (\cogsys@algminsize\space pt)}%
    \fi
  \fi}
% shrink in proportion until it fits (at most 4 times), then bisect between
% the largest size that fits and the smallest that does not
\def\cogsys@algshrink{%
  \cogsys@alglo=\z@ \cogsys@alghi=\cogsys@algtrial
  \cogsys@algtries=\z@
  \cogsys@algshrinkstep
  \ifdim\cogsys@alglo=\z@ \cogsys@alglo=\cogsys@algfloor \fi % nothing fits
  \cogsys@algtries=\z@
  \cogsys@algbisect
  \ifdim\cogsys@algtrial=\cogsys@alglo\else
    \cogsys@algtrial=\cogsys@alglo
    \cogsys@algbuild{\strip@pt\cogsys@alglo}%
  \fi}
\def\cogsys@algshrinkstep{%
  \advance\cogsys@algtries\@ne
  \ifdim\cogsys@algavail>\z@
    \cogsys@algtrial=\dimexpr\cogsys@algtrial*\cogsys@algavail
      /\cogsys@alght\relax
  \else
    \cogsys@algtrial=\cogsys@algfloor
  \fi
  \ifdim\cogsys@algtrial<\cogsys@algfloor \cogsys@algtrial=\cogsys@algfloor \fi
  \cogsys@algtry
  \let\cogsys@next\relax
  \ifdim\cogsys@alght>\cogsys@algavail
    \ifdim\cogsys@algtrial>\cogsys@algfloor
      \ifnum\cogsys@algtries<4 \let\cogsys@next\cogsys@algshrinkstep \fi
    \fi
  \fi
  \cogsys@next}
% about 5 steps, down to 0.05 pt
\def\cogsys@algbisect{%
  \let\cogsys@next\relax
  \ifnum\cogsys@algtries<5
    \ifdim\dimexpr\cogsys@alghi-\cogsys@alglo\relax>0.05pt
      \advance\cogsys@algtries\@ne
      \cogsys@algtrial=\dimexpr(\cogsys@alglo+\cogsys@alghi)/2\relax
      \cogsys@algtry
      \let\cogsys@next\cogsys@algbisect
    \fi
  \fi
  \cogsys@next}
\def\cogsys@algtry{%
  \cogsys@algbuild{\strip@pt\cogsys@algtrial}%
  \ifdim\cogsys@alght>\cogsys@algavail
    \cogsys@alghi=\cogsys@algtrial
  \else
    \cogsys@alglo=\cogsys@algtrial
  \fi}
\def\cogsys@gets{\ifmmode\leftarrow\else\textleftarrow\fi}

% Every build starts from the same state: counters stepped in the body
% (footnote marks, the marks of algpseudocodex, pgf's picture ids) and
% footnote texts are reset to what they were before the first build. So
% only the final build counts, and it gets the same names in every run.
\newbox\cogsys@algfootsave
\def\cogsys@algcounters{%
  \@elt{c@algpx@indentCount}\@elt{c@algpx@codeBoxCount}%
  \@elt{c@algpx@pageCount}\@elt{c@algpx@lastIndentEnded}%
  \@elt{c@algpx@tmpCount}\@elt{c@ALG@line}%
  \@elt{pgf@picture@serial@count}}
\def\cogsys@algsave{%
  \begingroup
    \let\@elt\cogsys@savecount
    \beamer@overlaycounterresets\cogsys@algcounters
  \endgroup
  \setbox\cogsys@algfootsave\copy\beamer@footins}
\def\cogsys@algrestore{%
  \begingroup
    \let\@elt\cogsys@restorecount
    \beamer@overlaycounterresets\cogsys@algcounters
  \endgroup
  \global\setbox\beamer@footins\copy\cogsys@algfootsave}
\def\cogsys@savecount#1{%
  \ifcsname#1\endcsname
    \expandafter\xdef\csname cogsys@sv@#1\endcsname{\the\csname#1\endcsname}%
  \fi}
\def\cogsys@restorecount#1{%
  \ifcsname#1\endcsname
    \global\csname#1\endcsname=\csname cogsys@sv@#1\endcsname\relax
  \fi}

% The room of each algorithm, measured when the slide is complete (right
% before beamer places the footnotes, see Footnotes):
%   free = \textheight - natural height of the frame and its footnotes
%          + what is left of the relaxable gap below the title
%   room = (heights of the algorithms in the same column or frame body
%           + free + extra room of the column) * share
% The extra room of a column is the height of the tallest column next to it
% minus its own: shrinking the algorithm only helps the frame if its column
% is the tallest. Several algorithms in one column share the room in
% proportion to their heights at the largest size.
% \cogsys@alg@<n> = {<column key>}{<columns group>}{<height>}{<largest height>}
% (empty for algorithms that are not fitted to the slide)
\def\cogsys@algnote{%
  \expandafter\xdef\csname cogsys@alg@\the\c@cogsys@alginslide\endcsname{%
    \ifx\cogsys@algfixedsize\relax\ifx\cogsys@algmaxheight\relax
      {\cogsys@colkey}{\cogsys@colgrp}{\the\cogsys@alght}%
      {\the\cogsys@algnatural}%
    \fi\fi}}
\def\cogsys@algget#1#2#3#4{%
  \def\cogsys@algk{#1}\def\cogsys@algg{#2}%
  \def\cogsys@algh{#3}\def\cogsys@algn{#4}}
\newdimen\cogsys@algfree
\newdimen\cogsys@algsumh
\newdimen\cogsys@algsumn
\newcount\cogsys@algi
\newcount\cogsys@algj
\newif\ifcogsys@algrerun
\def\cogsys@algmeasure{%
  \ifnum\c@cogsys@alginslide>\z@
  \ifbeamer@autobreak\else\ifbeamer@shrink\else
    \cogsys@framenatural\cogsys@algfree
    % the gap below the title gives way first (see Relaxed title gap): count
    % the room as if it were relaxed completely
    \cogsys@algfree=\dimexpr\textheight-\cogsys@algfree
      +\cogsys@relaxlimit-\cogsys@relaxapplied
      -1mm\relax % breathing room
    \cogsys@algi=\z@
    \cogsys@algeach
  \fi\fi\fi}
\def\cogsys@algeach{%
  \ifnum\cogsys@algi<\c@cogsys@alginslide
    \advance\cogsys@algi\@ne
    \cogsys@algroomof
    \expandafter\cogsys@algeach
  \fi}
\def\cogsys@algroomof{%
  \edef\cogsys@tmp{\csname cogsys@alg@\the\cogsys@algi\endcsname}%
  \ifx\cogsys@tmp\@empty\else
    \expandafter\cogsys@algget\cogsys@tmp
    \let\cogsys@algkey\cogsys@algk
    \let\cogsys@alggrp\cogsys@algg
    \cogsys@dimb=\cogsys@algn\relax
    \cogsys@algsumh=\z@ \cogsys@algsumn=\z@
    \cogsys@algj=\z@
    \cogsys@algsum
    \cogsys@dima=\z@
    \ifx\cogsys@alggrp\@empty\else
      \ifcsname cogsys@colht@\cogsys@algkey\endcsname
        \cogsys@dima=\dimexpr\csname cogsys@colmax@\cogsys@alggrp\endcsname
          -\csname cogsys@colht@\cogsys@algkey\endcsname\relax
      \fi
    \fi
    \cogsys@dima=\dimexpr\cogsys@algsumh+\cogsys@algfree+\cogsys@dima\relax
    \ifdim\cogsys@algsumn>\z@
      \cogsys@dima=\dimexpr\cogsys@dima*\cogsys@dimb/\cogsys@algsumn\relax
    \fi
    \ifdim\cogsys@dima<\z@ \cogsys@dima=\z@ \fi
    % the smallest room over the slides of the frame
    \edef\cogsys@algrid{\beamer@framestartpage-\the\cogsys@algi}%
    \ifcsname cogsys@algmin@\cogsys@algrid\endcsname
      \ifnum\c@page>\beamer@framestartpage\relax
        \ifdim\csname cogsys@algmin@\cogsys@algrid\endcsname<\cogsys@dima
          \cogsys@dima=\csname cogsys@algmin@\cogsys@algrid\endcsname\relax
        \fi
      \fi
    \else
      \xdef\cogsys@algids{\cogsys@algids,\cogsys@algrid}%
    \fi
    \expandafter\xdef\csname cogsys@algmin@\cogsys@algrid\endcsname{%
      \the\cogsys@dima}%
    \immediate\write\@auxout{\string\cogsys@algroom
      {\cogsys@algrid}{\the\cogsys@dima}}%
  \fi}
% sum up the algorithms with the same column key
\def\cogsys@algsum{%
  \ifnum\cogsys@algj<\c@cogsys@alginslide
    \advance\cogsys@algj\@ne
    \edef\cogsys@tmp{\csname cogsys@alg@\the\cogsys@algj\endcsname}%
    \ifx\cogsys@tmp\@empty\else
      \expandafter\cogsys@algget\cogsys@tmp
      \ifx\cogsys@algk\cogsys@algkey
        \advance\cogsys@algsumh\cogsys@algh\relax
        \advance\cogsys@algsumn\cogsys@algn\relax
      \fi
    \fi
    \expandafter\cogsys@algsum
  \fi}
% compare with the previous run
\def\cogsys@algids{}
\AtEndDocument{%
  \@for\cogsys@tmp:=\cogsys@algids\do{%
    \ifx\cogsys@tmp\@empty\else
      \ifcsname cogsys@algroom@\cogsys@tmp\endcsname
        \cogsys@dimb=\dimexpr\csname cogsys@algroom@\cogsys@tmp\endcsname
          -\csname cogsys@algmin@\cogsys@tmp\endcsname\relax
        \ifdim\cogsys@dimb<\z@ \cogsys@dimb=-\cogsys@dimb \fi
        \ifdim\cogsys@dimb>0.01pt \global\cogsys@algreruntrue \fi
      \else
        \global\cogsys@algreruntrue
      \fi
    \fi}%
  \ifcogsys@algrerun
    \PackageWarningNoLine{beamerthemecogsys}{The room for algorithms has
      changed.\MessageBreak Rerun to get their sizes right}%
  \fi}

% Columns: the natural height of every column, keyed <group>-<column>,
% groups counted per slide. \cogsys@colkey is the column a block sits in
% (F: the frame body).
\def\cogsys@colkey{F}
\def\cogsys@colgrp{}
\let\cogsys@mpcolumn\relax
\newif\ifcogsys@nextcol % the next minipage is a column
\newcount\cogsys@colgroups
\AddToHook{env/beamer@framepauses/begin}{\global\cogsys@colgroups=\z@}
\AddToHook{env/columns/begin}{%
  \global\advance\cogsys@colgroups\@ne
  \edef\cogsys@colgrp{\the\cogsys@colgroups}%
  \expandafter\xdef\csname cogsys@colmax@\cogsys@colgrp\endcsname{0pt}%
  \expandafter\xdef\csname cogsys@colcnt@\cogsys@colgrp\endcsname{0}%
  \cogsys@nextcoltrue}
\AddToHook{env/minipage/begin}{%
  \ifcogsys@nextcol
    \cogsys@nextcolfalse % minipages inside the column are no columns
    \expandafter\xdef\csname cogsys@colcnt@\cogsys@colgrp\endcsname{%
      \the\numexpr\csname cogsys@colcnt@\cogsys@colgrp\endcsname+1}%
    \edef\cogsys@mpcolumn{\cogsys@colgrp-%
      \csname cogsys@colcnt@\cogsys@colgrp\endcsname}%
    \let\cogsys@colkey\cogsys@mpcolumn
  \else
    \let\cogsys@mpcolumn\relax
  \fi}
% \@tempboxa holds the column right before it is placed
\patchcmd\endminipage{\egroup\expandafter\@iiiparbox}%
  {\egroup\cogsys@colmeasure\expandafter\@iiiparbox}{}%
  {\PackageWarningNoLine{beamerthemecogsys}{Could not patch minipage;
    algorithms in columns may get too small}}
\def\cogsys@colmeasure{%
  \ifx\cogsys@mpcolumn\relax\else
    % columns opening the slide: the highest first box of the columns,
    % measured from the baseline of the row (see Relaxed title gap)
    \ifcogsys@colsatbodytop
      \cogsys@firstbox\@tempboxa
      \ifdim\cogsys@relaxoffset>-\maxdimen
        \begingroup
          \setbox\z@\vtop{\unvcopy\@tempboxa}%
          \dimen@=\dimexpr\cogsys@relaxoffset-\ht\z@\relax
          \ifdim\dimen@<\cogsys@colinktop \global\cogsys@colinktop=\dimen@ \fi
        \endgroup
      \fi
    \fi
    \cogsys@dima=\dimexpr\ht\@tempboxa+\dp\@tempboxa\relax
    \expandafter\xdef\csname cogsys@colht@\cogsys@mpcolumn\endcsname{%
      \the\cogsys@dima}%
    \ifdim\cogsys@dima>\csname cogsys@colmax@\cogsys@colgrp\endcsname\relax
      \expandafter\xdef\csname cogsys@colmax@\cogsys@colgrp\endcsname{%
        \the\cogsys@dima}%
    \fi
  \fi}

%% ---------------------------------------------------------------------------
%% Language: language=en|ger
%% ---------------------------------------------------------------------------
% Switches the default labels of the theme (lecture, essential, excursus),
% the theorem tags (THM -> SATZ, EX -> BSP, ...) and, without babel or
% polyglossia, the LaTeX names (Figure, Table, Proof, ...). All names are
% hardcoded here, no dictionaries are loaded. With babel or polyglossia
% loaded, the LaTeX names follow the document language.
% Labels set with an option, own \cogsystheoremtag values and own
% \renewcommand\figurename etc. are kept.
\def\cogsys@ger{ger}
\newif\ifcogsys@langpkg   % babel or polyglossia loaded
\newif\ifcogsys@indoc
% \cogsys@ifsame{<macro>}{<text>}{<true>}{<false>}
\def\cogsys@ifsame#1#2{%
  \edef\cogsys@lang@a{\detokenize\expandafter{#1}}%
  \edef\cogsys@lang@b{\detokenize{#2}}%
  \ifx\cogsys@lang@a\cogsys@lang@b
    \expandafter\@firstoftwo\else\expandafter\@secondoftwo\fi}
% \cogsys@langname{<label>}{<en>}{<ger>}: unless set as an option
\def\cogsys@langname#1#2#3{%
  \@ifundefined{cogsys@#1name@set}{%
    \ifx\cogsys@language\cogsys@ger
      \@namedef{cogsys@#1name}{#3}\else\@namedef{cogsys@#1name}{#2}\fi}{}}
% \cogsys@langswap{<csname>}{<en>}{<ger>}: only if it holds the value of
% the other language, so values changed by the user stay
\def\cogsys@langswap#1#2#3{%
  \ifx\cogsys@language\cogsys@ger
    \expandafter\cogsys@ifsame\csname#1\endcsname{#2}{\@namedef{#1}{#3}}{}%
  \else
    \expandafter\cogsys@ifsame\csname#1\endcsname{#3}{\@namedef{#1}{#2}}{}%
  \fi}
\def\cogsys@langtheme{%
  \cogsys@langname{lecture}{Lecture}{Vorlesung}%
  \cogsys@langname{essential}{Essential}{Wichtig}%
  \cogsys@langname{excursus}{Excursus}{Exkurs}%
  \cogsys@langswap{cogsys@tag@theorem}{THM}{SATZ}%
  \cogsys@langswap{cogsys@tag@corollary}{COR}{FOLG}%
  \cogsys@langswap{cogsys@tag@fact}{FACT}{FAKT}%
  \cogsys@langswap{cogsys@tag@solution}{SOL}{L\"OS}%
  \cogsys@langswap{cogsys@tag@example}{EX}{BSP}%
  \cogsys@langswap{cogsys@tag@examples}{EX}{BSP}}
\def\cogsys@langkernel{%
  \ifcogsys@langpkg\else
    % English values as defined by beamer and amsthm
    \cogsys@langswap{figurename}{\translate{Figure}}{Abbildung}%
    \cogsys@langswap{tablename}{\translate{Table}}{Tabelle}%
    \cogsys@langswap{proofname}{Proof}{Beweis}%
    \cogsys@langswap{refname}{\translate{References}}{Literatur}%
    \cogsys@langswap{bibname}{\translate{Bibliography}}{Literaturverzeichnis}%
    \cogsys@langswap{contentsname}{\translate{Contents}}{Inhaltsverzeichnis}%
  \fi}
\def\cogsys@applylanguage{%
  \cogsys@langtheme
  \ifcogsys@indoc\cogsys@langkernel\fi}
\AtBeginDocument{%
  \@ifpackageloaded{babel}{\cogsys@langpkgtrue}{}%
  \@ifpackageloaded{polyglossia}{\cogsys@langpkgtrue}{}%
  \cogsys@indoctrue
  \cogsys@langkernel}
\cogsys@applylanguage

\endinput
