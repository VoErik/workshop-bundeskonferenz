% Body text: designed for the 10pt class option (9.9 pt, leading 1.45).
% We keep the size of the class option but always use the 1.45 leading.
\let\cogsys@orig@normalsize\normalsize
\renewcommand\normalsize{%
  \cogsys@orig@normalsize
  \cogsys@dima=\f@size pt\relax
  \cogsys@dimb=1.44\cogsys@dima
  \fontsize{\f@size}{\the\cogsys@dimb}\selectfont}
\AtBeginDocument{%
  \begingroup\cogsys@orig@normalsize
    \ifdim\f@size pt=10pt\else
      \PackageInfo{beamerthemecogsys}{The theme is designed for the 10pt
        class option;\MessageBreak this document uses \f@size pt}%
    \fi
  \endgroup}

%% ---------------------------------------------------------------------------
%% Metadata
%% ---------------------------------------------------------------------------
% \course[<short>]{<long>}  e.g. \course[OS]{Operating Systems}
% \semester{<term>}        e.g. \semester{WS 2026/27}
% \lecturenumber{<n>}      e.g. \lecturenumber{4}  -> LECTURE 04
\def\cogsys@course{}\def\cogsys@shortcourse{}
\def\cogsys@semester{}\def\cogsys@lecturenumber{}
\newcommand\course[2][]{%
  \def\cogsys@course{#2}%
  \if\relax\detokenize{#1}\relax\def\cogsys@shortcourse{#2}%
  \else\def\cogsys@shortcourse{#1}\fi}
\newcommand\semester[1]{\def\cogsys@semester{#1}}
\newcommand\lecturenumber[1]{%
  \def\cogsys@lecturenumber{#1}\cogsys@padifnumber{#1}}
% Both fall back to beamer's \lecture[<short>]{<long>}{<label>} (as used by
% the previous theme version). Expandable, so \MakeUppercase works on them.
\newcommand\insertcourse{%
  \ifx\cogsys@course\@empty
    \ifx\beamer@lecturename\@undefined\else\beamer@lecturename\fi
  \else\cogsys@course\fi}
\newcommand\insertshortcourse{%
  \ifx\cogsys@shortcourse\@empty
    \ifx\beamer@shortlecturename\@undefined\else\beamer@shortlecturename\fi
  \else\cogsys@shortcourse\fi}
\newcommand\insertsemester{\cogsys@semester}
\let\cogsys@beamer@lecturenumber\insertlecturenumber
\renewcommand\insertlecturenumber{%
  \ifx\cogsys@lecturenumber\@empty\cogsys@beamer@lecturenumber
  \else\cogsys@lecturenumberpadded\fi}

% Zero-pad a number to two digits (expandable; argument must be a number).
\def\cogsys@twodigits#1{\ifnum#1<10 0\fi\number#1}
% \lecturenumber accepts anything; only plain numbers get padded.
\def\cogsys@padifnumber#1{%
  \begingroup
  \afterassignment\cogsys@padifnumber@check
  \count@=0#1 \cogsys@padifnumber@end{#1}}
\def\cogsys@padifnumber@check#1\cogsys@padifnumber@end#2{%
  \if\relax\detokenize{#1}\relax
    \xdef\cogsys@lecturenumberpadded{\cogsys@twodigits{\count@}}%
  \else
    \gdef\cogsys@lecturenumberpadded{#2}%
  \fi
  \endgroup}

