%% beamerthemecogsys.sty
%% Lecture theme of the Cognitive Systems Group, University of Bamberg.
%%
%% Engines: pdfLaTeX (recommended), LuaLaTeX, XeLaTeX.
%% Hard requirements: beamer and graphicx. The theme does not use TikZ; all
%% drawing is done with TeX boxes and rules. Everything else is optional and
%% can be switched off with theme options, see README.md.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemecogsys}[2026/10/06 v2.1 CogSys lecture theme]

\RequirePackage{graphicx}

