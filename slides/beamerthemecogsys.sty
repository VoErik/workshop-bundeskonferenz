%% ---------------------------------------------------------------------------
%% Drawing primitives (plain TeX boxes and rules, no TikZ)
%% ---------------------------------------------------------------------------
% \cogsys@canvas{<width>}{<height>}{<items>}: a box of the given size whose
% items are placed with \cogsys@put relative to its top-left corner.
% \cogsys@put{<x>}{<y>}{<anchor>}{<content>}: <x>, <y> measured from the
% top-left corner (y downwards). Anchors: bl, br (baseline left/right),
% tl, tr (top left/right), c (centre).
\newbox\cogsys@putbox
\newdimen\cogsys@putx
\newdimen\cogsys@puty
\long\def\cogsys@canvas#1#2#3{%
  \vbox to#2{\offinterlineskip\parskip\z@\hrule\@width#1\@height\z@
    #3\vss}}
\long\def\cogsys@put#1#2#3#4{%
  \setbox\cogsys@putbox\hbox{\color@begingroup#4\color@endgroup}%
  \cogsys@putx=\dimexpr#1\relax
  \cogsys@puty=\dimexpr#2\relax
  \csname cogsys@anchor@#3\endcsname
  \nointerlineskip
  \vbox to\z@{\kern\cogsys@puty
    \hbox to\z@{\kern\cogsys@putx\box\cogsys@putbox\hss}\vss}}
\def\cogsys@anchor@tl{}
\def\cogsys@anchor@tr{\advance\cogsys@putx-\wd\cogsys@putbox}
\def\cogsys@anchor@bl{\advance\cogsys@puty-\ht\cogsys@putbox}
\def\cogsys@anchor@br{\cogsys@anchor@bl\cogsys@anchor@tr}
\def\cogsys@anchor@c{%
  \advance\cogsys@putx-.5\wd\cogsys@putbox
  \advance\cogsys@puty-.5\dimexpr\ht\cogsys@putbox+\dp\cogsys@putbox\relax}

% \cogsys@rect{<width>}{<height>}{<colour>}: filled rectangle on the baseline
\def\cogsys@rect#1#2#3{%
  {\color{#3}\vrule\@width#1\@height#2\@depth\z@}}

% Tag box used by ESSENTIAL / EXCURSUS and block tabs. The box is sized
% like the CSS box of the reference: <above> from the top edge to the cap
% height, <below> from the baseline to the bottom edge, <h pad> from the
% side edges to the text (all to the outer edges; borders are drawn inside).
% \cogsys@tagbox{<text>}{<fill colour or empty>}{<none|solid|dashed>}%
%               {<above>}{<below>}{<h pad>}
\newbox\cogsys@tagtext
\newdimen\cogsys@tagw \newdimen\cogsys@tagh \newdimen\cogsys@tagd
\newdimen\cogsys@tagrule \cogsys@tagrule=0.25mm
\def\cogsys@tagbox#1#2#3#4#5#6{%
  \setbox\cogsys@tagtext\hbox{\color@begingroup#1\color@endgroup}%
  \cogsys@tagh=\dimexpr\fontcharht\font`H+#4\relax
  \cogsys@tagd=\dimexpr#5\relax
  \cogsys@tagw=\dimexpr\wd\cogsys@tagtext+#6+#6\relax
  \hbox{%
    \if\relax\detokenize{#2}\relax\else
      \rlap{\color{#2}\vrule\@width\cogsys@tagw\@height\cogsys@tagh
            \@depth\cogsys@tagd}%
    \fi
    \csname cogsys@border@#3\endcsname
    \kern#6\box\cogsys@tagtext\kern#6}}
\def\cogsys@border@none{}
\def\cogsys@border@solid{%
  \rlap{\color{cogsysink}\lower\cogsys@tagd\vbox{\offinterlineskip
    \hrule\@height\cogsys@tagrule\@width\cogsys@tagw
    \hbox to\cogsys@tagw{\vrule\@width\cogsys@tagrule
        \@height\dimexpr\cogsys@tagh+\cogsys@tagd-2\cogsys@tagrule\relax
      \hfil\vrule\@width\cogsys@tagrule}%
    \hrule\@height\cogsys@tagrule\@width\cogsys@tagw}}}
% dashes: 0.5 mm on, 0.25 mm off
\def\cogsys@hdash{\hbox to\cogsys@tagw{%
  \cleaders\hbox to0.75mm{\hss\vrule\@width0.5mm\@height\cogsys@tagrule\hss}\hfil}}
\def\cogsys@vdash{\vbox to\dimexpr\cogsys@tagh+\cogsys@tagd-2\cogsys@tagrule\relax{%
  \cleaders\vbox to0.75mm{\vss\hrule\@width\cogsys@tagrule\@height0.5mm\vss}\vfil}}
\def\cogsys@border@dashed{%
  \rlap{\color{cogsysink}\lower\cogsys@tagd\vbox{\offinterlineskip
    \cogsys@hdash
    \hbox to\cogsys@tagw{\cogsys@vdash\hfil\cogsys@vdash}%
    \cogsys@hdash}}}

%% ---------------------------------------------------------------------------
%% Flag underline
%% ---------------------------------------------------------------------------
% \cogsys@flagbar{<width>}{<height>}: a box of that size on the baseline
\def\cogsys@flagbar#1#2{%
  \def\cogsys@tmp{pride}%
  \ifx\cogsys@flag\cogsys@tmp
    \cogsys@stripes{#1}{#2}{cogsysprideA,cogsysprideB,cogsysprideC,%
                            cogsysprideD,cogsysprideE,cogsysprideF}{6}%
  \else
    \def\cogsys@tmp{palestine}%
    \ifx\cogsys@flag\cogsys@tmp
      \cogsys@stripes{#1}{#2}{cogsyspalA,cogsyspalB,cogsyspalC,cogsyspalD}{4}%
    \else
      \def\cogsys@tmp{trans}%
      \ifx\cogsys@flag\cogsys@tmp
        \cogsys@stripes{#1}{#2}{cogsystransA,cogsystransB,cogsyspaper,%
                                cogsystransB,cogsystransA}{5}%
      \else
        \hbox{\cogsys@rect{#1}{#2}{cogsysink}}%
      \fi
    \fi
  \fi}
% equal segments; the last one takes the rounding remainder
\def\cogsys@stripes#1#2#3#4{%
  \hbox{\cogsys@dimc=\dimexpr(#1)/#4\relax
    \count@=\z@
    \@for\cogsys@c:=#3\do{%
      \advance\count@\@ne
      \ifnum\count@=#4
        \cogsys@dimc=\dimexpr#1-\cogsys@dimc*(#4-1)\relax
      \fi
      \cogsys@rect{\cogsys@dimc}{#2}{\cogsys@c}}}}

%% ---------------------------------------------------------------------------
%% Frame kinds: essential / excursus
%% ---------------------------------------------------------------------------
% \begin{frame}[essential]{...}  important slide, solid bar + ESSENTIAL tag
% \begin{frame}[excursus]{...}   optional slide, hatched bar + EXCURSUS tag
\def\cogsys@framekind{normal}
% \cogsys@essentialname, \cogsys@excursusname: set by the language option
\define@key{beamerframe}{essential}[true]{\def\cogsys@framekind{essential}}
\define@key{beamerframe}{excursus}[true]{\def\cogsys@framekind{excursus}}
% \begin{frame}[norelax]{...}   keep the full gap below the title (see
% Relaxed title gap)
\newif\ifcogsys@norelax
\define@key{beamerframe}{norelax}[true]{\cogsys@norelaxtrue}
% every frame starts as a normal one (also fragile frames)
\pretocmd\beamer@@@@frame{\def\cogsys@framekind{normal}\cogsys@norelaxfalse}{}%
  {\PackageWarningNoLine{beamerthemecogsys}{Could not patch beamer's frame}}
% excursus colours
\setbeamercolor{excursus canvas}{bg=cogsysexcursus}
\setbeamercolor{excursus frametitle}{fg=cogsysgrey555}
% \cogsys@canvascolor: colour `bg' = canvas colour of the current frame
\def\cogsys@canvascolor{%
  \usebeamercolor{background canvas}%
  \cogsys@ifkind{excursus}{\usebeamercolor{excursus canvas}}}
\setbeamertemplate{background canvas}{%
  \cogsys@canvascolor\color{bg}\vrule width\paperwidth height\paperheight}
% \cogsys@ifkind{<kind>}{<code>}
\def\cogsys@ifkind#1#2{\def\cogsys@tmp{#1}%
  \ifx\cogsys@tmp\cogsys@framekind\expandafter\@firstofone
  \else\expandafter\@gobble\fi{#2}}

%% ---------------------------------------------------------------------------
%% Page kinds: the title and section pages are drawn on the canvas
