      \cogsys@fitline{\usebeamerfont{frametitle}}{\cogsys@titlesize}%
        {\insertframetitle}{\cogsys@titlewidth}}%
    \ifx\insertframesubtitle\@empty
      \cogsys@put{\z@}{20.81mm}{tl}{\cogsys@flagbar{9mm}{0.75mm}}%
    \else
